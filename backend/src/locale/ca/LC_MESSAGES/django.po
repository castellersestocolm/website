#: comunicat/templates/email/towers/user/signup.html:6
msgid ""
"We have some upcoming performances, please make sure to update your "
"attendance as soon as you can!"
msgstr ""
"Tenim actuacions properes, assegura't d'actualitzar la teva assistència tan "
"aviat com puguis!"

#: comunicat/templates/email/towers/user/signup.html:7
